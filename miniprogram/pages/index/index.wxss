.page { padding: 24rpx; }
.hero { padding: 40rpx 8rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; color: #999; margin-top: 12rpx; }
.cond-box { background: #fff; border-radius: 12rpx; padding: 20rpx; font-size: 24rpx; color: #666; }
.actions { display: flex; margin-top: 24rpx; }
.ghost-btn { flex: 1; background: #fff; color: #DA291C; border: 2rpx solid #DA291C; border-radius: 12rpx; font-size: 26rpx; margin-right: 16rpx; }
.ghost-btn:last-child { margin-right: 0; }
.selfcheck { margin-top: 40rpx; }
.link-btn { background: transparent; color: #999; font-size: 24rpx; text-decoration: underline; }
.check { font-size: 24rpx; padding: 8rpx 0; }
.check.pass { color: #07c160; }
.check.fail { color: #DA291C; }
.err { color: #DA291C; font-size: 22rpx; word-break: break-all; }
.disclaimer-footer { text-align: center; color: #ccc; font-size: 20rpx; margin-top: 40rpx; }
