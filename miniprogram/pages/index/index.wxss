.container { padding: 40rpx; }
.disclaimer { color: #999; font-size: 24rpx; margin-bottom: 40rpx; text-align: center; }
.ping-btn { background: #DA291C; color: #fff; border-radius: 12rpx; }
.check-item { margin-top: 24rpx; padding: 20rpx; border-radius: 8rpx; background: #fff; }
.check-item.pass { color: #07c160; }
.check-item.fail { color: #DA291C; }
.error { margin-top: 24rpx; color: #DA291C; word-break: break-all; }
