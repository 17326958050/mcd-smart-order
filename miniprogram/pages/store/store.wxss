.page { padding: 24rpx; }
.search-row { display: flex; align-items: center; }
.search-input { flex: 1; background: #fff; border-radius: 12rpx; padding: 16rpx 24rpx; font-size: 26rpx; }
.search-btn { margin-left: 16rpx; background: #DA291C; color: #fff; font-size: 26rpx; border-radius: 12rpx; line-height: 68rpx; padding: 0 28rpx; }
.hint { color: #999; font-size: 22rpx; margin: 20rpx 0; }
.store-item { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 16rpx; }
.store-name { font-size: 30rpx; font-weight: 600; }
.store-addr { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.empty { text-align: center; color: #999; font-size: 26rpx; padding: 80rpx 0; }
.disclaimer-footer { text-align: center; color: #ccc; font-size: 20rpx; margin-top: 40rpx; }
