<!-- 门店选择页：搜索 + 列表 + 空态 -->
<view class="page">
  <view class="search-row">
    <input class="search-input city-input" placeholder="城市（必填，如：大连）" value="{{city}}"
           bindinput="onCityInput" confirm-type="next" />
  </view>
  <view class="search-row">
    <input class="search-input" placeholder="门店名称/关键词（默认搜麦当劳）" value="{{keyword}}"
           bindinput="onSearchInput" confirm-type="search" bindconfirm="onSearch" />
    <button class="search-btn" bindtap="onSearch" loading="{{loading}}">搜索</button>
  </view>

  <view class="hint">{{locTip || '输入城市搜索附近门店，精确门店由你手动选择'}}</view>

  <view class="mock-badge" wx:if="{{mock}}">演示数据（未配置 MCP Token 时为离线 Mock）</view>

  <view wx:for="{{stores}}" wx:key="id" class="store-item" data-store="{{item}}" bindtap="onSelectStore">
    <view class="store-name">{{item.name}}</view>
    <view class="store-addr">{{item.address}}</view>
    <view class="store-dist" wx:if="{{item.distanceMeters != null}}">距离约 {{item.distanceMeters}} 米</view>
  </view>

  <view wx:if="{{empty && !loading}}" class="empty">{{emptyReason || '暂无门店'}}</view>

  <view class="disclaimer-footer">本项目为参赛作品，非麦当劳官方产品</view>
</view>
