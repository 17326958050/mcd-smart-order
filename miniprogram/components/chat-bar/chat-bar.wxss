.chat-bar { display: flex; align-items: center; padding: 16rpx; background: #fff; border-top: 1rpx solid #eee; }
.chat-input { flex: 1; background: #f5f5f5; border-radius: 32rpx; padding: 16rpx 24rpx; font-size: 26rpx; }
.chat-send { margin-left: 16rpx; background: #DA291C; color: #fff; font-size: 26rpx; border-radius: 32rpx; padding: 0 32rpx; line-height: 64rpx; }
